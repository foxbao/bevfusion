      "cwd": "${workspaceFolder}",
      "justMyCode": false,
      "env": {
        "CUDA_VISIBLE_DEVICES": "0",
        "MASTER_HOST": "127.0.0.1:29500", 
        "MASTER_PORT": "12345",
        "RANK": "0",
        "WORLD_SIZE": "1"
      }
    }
  ]
}
