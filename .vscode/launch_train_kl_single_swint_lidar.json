{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug BEVFusion (single GPU)",
      "type": "debugpy",
      "request": "launch",
      "program": "tools/train.py",
      "console": "integratedTerminal",
      "args": [
        "configs/kl/det/transfusion/secfpn/camera_lidar/swint_v0p075/convfuser.yaml",
        "--run-dir",
        "output/swint_lidar_kl/"
