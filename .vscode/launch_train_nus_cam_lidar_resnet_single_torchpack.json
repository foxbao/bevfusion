{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug BEVFusion (single GPU)",
      "type": "debugpy",
      "request": "launch",
      "program": "tools/train.py",
      "console": "integratedTerminal",
      "args": [
        "configs/nuscenes/det/transfusion/secfpn/camera_lidar/resnet50/convfuser.yaml",
        "--run-dir",
        "output/camera_lidar_resnet50/"
      ],
      "cwd": "${workspaceFolder}",
      "justMyCode": false,
      "env": {
        "CUDA_VISIBLE_DEVICES": "0" ,
        "MASTER_HOST": "127.0.0.1:29500",   // 注意加端口
        "MASTER_PORT": "29500",
        "WORLD_SIZE": "1",
        "RANK": "0",
        "LOCAL_RANK": "0"
      }
    }
  ]
}
