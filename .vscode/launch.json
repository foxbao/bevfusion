{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug BEVFusion (single GPU)",
      "type": "debugpy",
      "request": "launch",
      "program": "tools/test.py",
      "console": "integratedTerminal",
      "args": [
        "configs/kl/det/transfusion/secfpn/lidar/voxelnet_0p075.yaml",
        "output/lidar_result_mini/latest.pth",
        "--eval","bbox",
        // "--out","output/lidar_result_mini/result.pkl",
        "--load-pkl","output/lidar_result_mini/result.pkl"
      ],
      "cwd": "${workspaceFolder}",
      "justMyCode": false,
      "env": {
        "CUDA_VISIBLE_DEVICES": "0" ,
        "MASTER_HOST": "127.0.0.1:29500",   // 注意加端口
        "MASTER_PORT": "29500",
        "WORLD_SIZE": "1",
        "RANK": "0",
        "LOCAL_RANK": "0"
      }
    }
  ]
}
