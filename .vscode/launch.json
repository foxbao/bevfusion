{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Create KL mini Data",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/tools/create_data.py",
      "args": [
        "kl",
        "--root-path", "./data/kl",
        "--out-dir", "./data/kl",
        "--extra-tag", "kl",
        "--version", "v1.0-mini"
      ],
      "console": "integratedTerminal",
      "justMyCode": false
    }
  ]
}
